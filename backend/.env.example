# Environment
ENVIRONMENT=development

# Logging: debug, info, warn, error
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://messenger:password@localhost:5432/messenger_dev?sslmode=disable

# Redis
REDIS_URL=localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string

# =============================================================================
# Provider chain (unified PROVIDER_<ALIAS>_<KEY> definitions)
# =============================================================================
# Translation uses the fast local LibreTranslate sidecar FIRST (~20-30ms warm),
# then falls back to the cloud LLM chain. Grammar analysis skips
# translation-only providers and uses the LLM endpoints directly.
#
# Supported provider types:
#   opencode          - OpenCode Go (OpenAI-compatible)
#   openrouter        - OpenRouter (OpenAI-compatible)
#   openai            - OpenAI API
#   deepseek          - DeepSeek API
#   nvidia            - NVIDIA AI Foundation (OpenAI-compatible)
#   ollama            - Local Ollama instance
#   translator-engine - Legacy llama.cpp translator engine
#   libretranslate    - Local LibreTranslate sidecar (Argos/OPUS-MT)
#
# Chain order (first successful response wins):
#   TRANSLATION_PROVIDER_ORDER=libretranslate,openrouter,nvidia,opencode_go,ollama_local
#   GRAMMAR_ANALYSIS_PROVIDER_ORDER=openrouter,nvidia,opencode_go,ollama_local
#
# All cloud providers use the OpenAI-compatible /v1/chat/completions API and
# require PROVIDER_<ALIAS>_API_KEY / _API_URL / _MODEL.
# Local providers (ollama, libretranslate, translator-engine) need no API key.

TRANSLATION_PROVIDER_ORDER=libretranslate,openrouter,nvidia,opencode_go,ollama_local
GRAMMAR_ANALYSIS_PROVIDER_ORDER=openrouter,nvidia,opencode_go,ollama_local
TRANSLATION_CHAIN_TIMEOUT=120

# LibreTranslate (first translation provider)
PROVIDER_LIBRETRANSLATE_TYPE=libretranslate
PROVIDER_LIBRETRANSLATE_API_URL=http://localhost:5000   # host dev
# In-Docker backend: http://libretranslate:5000
PROVIDER_LIBRETRANSLATE_TIMEOUT=10

# OpenRouter (primary LLM for analysis + translation fallback)
PROVIDER_OPENROUTER_TYPE=openrouter
PROVIDER_OPENROUTER_API_URL=https://openrouter.ai
PROVIDER_OPENROUTER_API_KEY=
PROVIDER_OPENROUTER_MODEL=google/gemini-2.5-flash-lite:free

# OpenCode Go (OpenAI-compatible, rate-limited)
PROVIDER_OPENCODE_GO_TYPE=opencode
PROVIDER_OPENCODE_GO_API_URL=https://opencode.ai/zen/go/v1
PROVIDER_OPENCODE_GO_API_KEY=
PROVIDER_OPENCODE_GO_MODEL=deepseek-v4-flash

# NVIDIA AI Foundation (fallback)
PROVIDER_NVIDIA_TYPE=nvidia
PROVIDER_NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
PROVIDER_NVIDIA_API_KEY=
PROVIDER_NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Local Ollama (final fallback, no rate limits)
PROVIDER_OLLAMA_LOCAL_TYPE=ollama
PROVIDER_OLLAMA_LOCAL_API_URL=http://localhost:11434
PROVIDER_OLLAMA_LOCAL_MODEL=qwen2.5:3b
PROVIDER_OLLAMA_LOCAL_TIMEOUT=600

# =============================================================================
# Legacy single-translation-provider config (used when TRANSLATION_PROVIDER_ORDER
# is empty). Kept for backward compatibility.
# =============================================================================
TRANSLATION_PROVIDER_NAME=opencode
TRANSLATION_PROVIDER_API_URL=https://api.opencode.com/v1
TRANSLATION_PROVIDER_API_KEY=
TRANSLATION_PROVIDER_MODEL=

# =============================================================================
# Quick Reference: Provider Settings Matrix
# =============================================================================
#
# Provider name keyword | API URL example                       | Needs API Key? | Default model
# ----------------------|---------------------------------------|----------------|----------------
# opencode              | https://api.opencode.com/v1           | Yes            | gpt-4o-mini
# openrouter            | https://openrouter.ai                 | Yes            | (varies)
# openai                | https://api.openai.com/v1             | Yes            | gpt-4o-mini
# deepseek              | https://api.deepseek.com/v1           | Yes            | deepseek-chat
# nvidia                | https://integrate.api.nvidia.com/v1   | Yes            | (varies)
# ollama                | http://localhost:11434                | No             | qwen2.5:3b
# translator-engine     | http://localhost:5002                 | No             | (fixed)
# libretranslate        | http://localhost:5000                 | No             | (n/a)

# Server
PORT=8080