# Environment
ENVIRONMENT=development

# Logging: debug, info, warn, error
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://messenger:password@localhost:5432/messenger_dev?sslmode=disable

# Redis
REDIS_URL=localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string

# Waitlist and invite-only registration email (Mailu SMTP)
# Set these from the Mailu mailbox that sends Chorus invitations.
MAILU_SMTP_HOST=mail.zumy.app
MAILU_SMTP_PORT=465
MAILU_SMTP_USERNAME=your-mailbox@your-domain.com
MAILU_SMTP_PASSWORD=
MAILU_SMTP_FROM=your-mailbox@your-domain.com
INVITE_BASE_URL=https://your-domain.com/register
INVITE_TTL_HOURS=168
# Comma-separated emails allowed to approve waitlist entries.
WAITLIST_ADMIN_EMAILS=

# =============================================================================
# Provider chains (canonical env keys)
#   PROVIDER_<NAME>_URL / PROVIDER_<NAME>_KEY / PROVIDER_<NAME>_TIMEOUT
#   Provider type is derived from the provider name — no TYPE key needed.
#   Per-task models: MODEL_TRANSLATION_<NAME>, MODEL_GRAMMAR_<NAME>.
# =============================================================================
# Supported provider names (case-insensitive):
#   openrouter, opencode, openai, deepseek, nvidia, ollama, libretranslate,
#   translator-engine
#   (provider type is derived from the name, so chain aliases must use these)
#
# Chain order (first successful response wins):
#   TRANSLATION_FALLBACK_ORDER=openrouter,nvidia,opencode,ollama,libretranslate
#   GRAMMAR_FALLBACK_ORDER=opencode,openrouter,nvidia,ollama
#
# ollama is the offline-first provider: it needs no API key, auto-pulls its
# model at startup if missing, and always works when cloud providers fail,
# are rate-limited (429), or lack keys. Local providers (ollama,
# libretranslate, translator-engine) need no API key.

TRANSLATION_FALLBACK_ORDER=openrouter,nvidia,opencode,ollama,libretranslate
GRAMMAR_FALLBACK_ORDER=opencode,openrouter,nvidia,ollama
TRANSLATION_CHAIN_TIMEOUT=120

# OpenRouter (primary LLM for analysis + translation fallback)
PROVIDER_OPENROUTER_URL=https://openrouter.ai/api/v1
PROVIDER_OPENROUTER_KEY=
MODEL_TRANSLATION_OPENROUTER=google/gemma-4-26b-a4b-it:free
MODEL_GRAMMAR_OPENROUTER=meta/llama-3.1-8b-instruct

# OpenCode Go (OpenAI-compatible)
PROVIDER_OPENCODE_URL=https://opencode.ai/zen/go/v1
PROVIDER_OPENCODE_KEY=
MODEL_TRANSLATION_OPENCODE=deepseek-v4-flash
MODEL_GRAMMAR_OPENCODE=deepseek-v4-flash

# NVIDIA AI Foundation (fallback)
PROVIDER_NVIDIA_URL=https://integrate.api.nvidia.com/v1
PROVIDER_NVIDIA_KEY=
MODEL_TRANSLATION_NVIDIA=meta/llama-3.1-70b-instruct
MODEL_GRAMMAR_NVIDIA=meta/llama-3.1-8b-instruct

# Local Ollama (offline-first fallback). No API key needed.
# MODEL: qwen2.5:3b (~2 GB RAM) — proven for strict JSON and multilingual.
PROVIDER_OLLAMA_URL=http://localhost:11434
PROVIDER_OLLAMA_TIMEOUT=600
MODEL_TRANSLATION_OLLAMA=qwen2.5:3b
MODEL_GRAMMAR_OLLAMA=qwen2.5:1.5b
# Seconds the backend blocks startup while auto-pulling a missing Ollama model.
OLLAMA_STARTUP_PULL_TIMEOUT=600

# LibreTranslate (fast local sidecar — no API key)
PROVIDER_LIBRETRANSLATE_URL=http://localhost:5000   # host dev
# In-Docker backend: http://libretranslate:5000
PROVIDER_LIBRETRANSLATE_TIMEOUT=10

# Server
PORT=8080