# Environment
ENVIRONMENT=development

# Logging: debug, info, warn, error
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://messenger:password@localhost:5432/messenger_dev?sslmode=disable

# Redis
REDIS_URL=localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string

# =============================================================================
# Translation Provider Configuration (Unified)
# =============================================================================
# Choose which translation backend to use.
# Supported provider names:
#   opencode          - OpenCode Go (OpenAI-compatible) - DEFAULT
#   openai            - OpenAI API
#   deepseek          - DeepSeek API
#   nvidia            - NVIDIA AI Foundation (OpenAI-compatible)
#   ollama            - Local Ollama instance
#   translator-engine - Legacy llama.cpp translator engine
#   libretranslate    - Local LibreTranslate sidecar (Argos/OPUS-MT, ~100-300ms).
#                       Docker: docker compose up -d libretranslate (port 5000).
#                       Configured via the chain: PROVIDER_LIBRETRANSLATE_TYPE=libretranslate,
#                       PROVIDER_LIBRETRANSLATE_API_URL=http://localhost:5000,
#                       and TRANSLATION_PROVIDER_ORDER=libretranslate,...
#
# All cloud providers (opencode, openai, deepseek) use the OpenAI-compatible
# /v1/chat/completions API. They require:
#   - TRANSLATION_PROVIDER_API_KEY (your API key)
#   - TRANSLATION_PROVIDER_API_URL (the API endpoint)
#   - TRANSLATION_PROVIDER_MODEL (the model to use)
#
# Local providers (ollama, translator-engine) do NOT need an API key.
# They only need:
#   - TRANSLATION_PROVIDER_API_URL (the local server URL)
#   - TRANSLATION_PROVIDER_MODEL (optional, model name)
TRANSLATION_PROVIDER_NAME=opencode

# API URL for the selected provider.
# Examples by provider:
#   opencode:          https://api.opencode.com/v1
#   openai:            https://api.openai.com/v1
#   deepseek:          https://api.deepseek.com/v1
#   ollama:            http://localhost:11434
#   translator-engine: http://localhost:5002
# Leave empty to use the default URL for the selected provider.
TRANSLATION_PROVIDER_API_URL=https://api.opencode.com/v1

# API key for the selected provider.
# Required for: opencode, openai, deepseek
# Not needed for: ollama, translator-engine
TRANSLATION_PROVIDER_API_KEY=

# Model name for the selected provider.
# Examples by provider:
#   opencode:          gpt-4o-mini (default)
#   openai:            gpt-4o-mini (default)
#   deepseek:          deepseek-chat (default)
#   ollama:            qwen2.5:3b (default)
#   translator-engine: (not used - model is fixed by the engine)
# Leave empty to use the default model for the selected provider.
TRANSLATION_PROVIDER_MODEL=

# =============================================================================
# Quick Reference: Provider Settings Matrix
# =============================================================================
#
# Provider name keyword | API URL example                       | Needs API Key? | Default model
# ----------------------|---------------------------------------|----------------|----------------
# opencode              | https://api.opencode.com/v1           | Yes            | gpt-4o-mini
# openai                | https://api.openai.com/v1             | Yes            | gpt-4o-mini
# deepseek              | https://api.deepseek.com/v1           | Yes            | deepseek-chat
# ollama                | http://localhost:11434                | No             | qwen2.5:3b
# translator-engine     | http://localhost:5002                 | No             | (fixed)

# Server
PORT=8080