# Environment
ENVIRONMENT=development

# Logging: debug, info, warn, error
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://messenger:password@localhost:5432/messenger_dev?sslmode=disable

# Redis
REDIS_URL=localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string

# =============================================================================
# External LLM Provider Configuration (Unified — used for BOTH translation and grammar)
# =============================================================================
# Instead of having separate provider chains for translation and grammar,
# a single EXTERNAL_LLM_PROVIDER_ORDER controls the order in which providers
# are tried for both services. Each alias in the order corresponds to a
# PROVIDER_<ALIAS>_<KEY> env var set below.
#
# Supported provider types:
#   opencode   - OpenCode (OpenAI-compatible)
#   openrouter - OpenRouter (OpenAI-compatible)
#   openai     - OpenAI API
#   deepseek   - DeepSeek API
#   nvidia     - NVIDIA AI Foundation (OpenAI-compatible)
#   ollama     - Local Ollama instance
#
# All cloud providers use the OpenAI-compatible /v1/chat/completions API.
# They require:
#   - PROVIDER_<ALIAS>_API_KEY (your API key)
#   - PROVIDER_<ALIAS>_API_URL (the API endpoint)
#   - PROVIDER_<ALIAS>_MODEL (the model to use)
#
# Local providers (ollama) do NOT need an API key.
#
# Example:
#   EXTERNAL_LLM_PROVIDER_ORDER=primary,secondary,local
#   PROVIDER_PRIMARY_TYPE=opencode
#   PROVIDER_PRIMARY_API_URL=https://api.opencode.com/v1
#   PROVIDER_PRIMARY_API_KEY=sk-...
#   PROVIDER_PRIMARY_MODEL=gpt-4o-mini
#   PROVIDER_SECONDARY_TYPE=openai
#   PROVIDER_SECONDARY_API_URL=https://api.openai.com/v1
#   PROVIDER_SECONDARY_API_KEY=sk-...
#   PROVIDER_SECONDARY_MODEL=gpt-4o-mini
#   PROVIDER_LOCAL_TYPE=ollama
#   PROVIDER_LOCAL_API_URL=http://localhost:11434
#   PROVIDER_LOCAL_MODEL=qwen2.5:3b

# Provider order (comma-separated list of aliases matching PROVIDER_<ALIAS>_* vars)
EXTERNAL_LLM_PROVIDER_ORDER=

# Translation chain timeout (seconds) — total timeout across all providers
TRANSLATION_CHAIN_TIMEOUT=120

# =============================================================================
# Legacy single-provider config (fallback when EXTERNAL_LLM_PROVIDER_ORDER is empty)
# =============================================================================
# These are only used if EXTERNAL_LLM_PROVIDER_ORDER is not set.
TRANSLATION_PROVIDER_NAME=opencode
TRANSLATION_PROVIDER_API_URL=https://api.opencode.com/v1
TRANSLATION_PROVIDER_API_KEY=
TRANSLATION_PROVIDER_MODEL=

# =============================================================================
# Quick Reference: Provider Settings Matrix
# =============================================================================
#
# Type keyword | API URL example                       | Needs API Key? | Default model
# -------------|---------------------------------------|----------------|----------------
# opencode     | https://api.opencode.com/v1           | Yes            | gpt-4o-mini
# openrouter   | https://openrouter.ai                 | Yes            | (varies)
# openai       | https://api.openai.com/v1             | Yes            | gpt-4o-mini
# deepseek     | https://api.deepseek.com/v1           | Yes            | deepseek-chat
# nvidia       | https://integrate.api.nvidia.com/v1   | Yes            | (varies)
# ollama       | http://localhost:11434                | No             | qwen2.5:3b

# Server
PORT=8080