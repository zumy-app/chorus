# Chorus Messenger — Production Environment Variables (reference)
# Copy to .env.prod and fill in your values.
# These will be loaded by Dokploy at deploy time.

# ─── Database ──────────────────────────────────────────────
DB_PASSWORD=ChangeMe123

# ─── JWT Secret (REQUIRED — generate a strong random key) ──
# Generate with: openssl rand -base64 64
JWT_SECRET=your-very-long-random-secret-at-least-64-chars

# ─── Server ────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Legacy single-provider translation (fallback) ─────────
TRANSLATION_PROVIDER_NAME=opencode
TRANSLATION_PROVIDER_API_URL=https://opencode.ai/zen/go/v1
TRANSLATION_PROVIDER_API_KEY=
TRANSLATION_PROVIDER_MODEL=deepseek-v4-flash

# ─── Multi-provider chain (translation) ────────────────────
TRANSLATION_PROVIDER_ORDER=nvidia,ollama_local,opencode_go
TRANSLATION_CHAIN_TIMEOUT=300

# Provider definitions (each alias gets a PROVIDER_<ALIAS>_<KEY> prefix)
PROVIDER_OPENCODE_GO_TYPE=opencode
PROVIDER_OPENCODE_GO_API_URL=https://opencode.ai/zen/go/v1
PROVIDER_OPENCODE_GO_API_KEY=
PROVIDER_OPENCODE_GO_MODEL=deepseek-v4-flash

PROVIDER_NVIDIA_TYPE=nvidia
PROVIDER_NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
PROVIDER_NVIDIA_API_KEY=
PROVIDER_NVIDIA_MODEL=meta/llama-3.1-70b-instruct

PROVIDER_OLLAMA_LOCAL_TYPE=ollama
PROVIDER_OLLAMA_LOCAL_API_URL=http://ollama:11434
PROVIDER_OLLAMA_LOCAL_MODEL=llama3.2:3b-instruct-q4_K_M
PROVIDER_OLLAMA_LOCAL_TIMEOUT=600

# ─── Grammar AI ────────────────────────────────────────────
GRAMMAR_API_URL=https://opencode.ai/zen/go/v1
GRAMMAR_API_KEY=
GRAMMAR_MODEL=deepseek-v4-flash

# ─── Multi-provider chain (grammar) ────────────────────────
GRAMMAR_PROVIDER_ORDER=nvidia,ollama_local,opencode_go

# ─── Appwrite (optional) ──────────────────────────────────
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_CLIENT_API_KEY=