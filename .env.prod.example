# Chorus Messenger — Production Environment Variables
# Copy this to .env.prod and fill in your values.
# These will be loaded by Dokploy at deploy time.

# ─── Database ──────────────────────────────────────────────
# Note: DB_PASSWORD is no longer used. docker-compose.prod.yml hardcodes the
# DB password (CHANGED in both POSTGRES_PASSWORD and DATABASE_URL), and
# deploy/postgres/entrypoint.sh re-syncs the stored DB password to it on every
# container start, so an existing postgres volume needs no action.
# DB_PASSWORD=ChangeMe123

# ─── JWT Secret (REQUIRED — generate a strong random key) ──
# Generate with: openssl rand -base64 64
JWT_SECRET=your-very-long-random-secret-at-least-64-chars

# ─── Waitlist and invitation email: Mailu SMTP (REQUIRED) ──
# Use the full Mailu mailbox address for USERNAME and FROM.
MAILU_SMTP_HOST=mail.zumy.app
MAILU_SMTP_PORT=465
MAILU_SMTP_USERNAME=your-mailbox@your-domain.com
MAILU_SMTP_PASSWORD=
MAILU_SMTP_FROM=your-mailbox@your-domain.com
INVITE_BASE_URL=https://your-domain.com/register
INVITE_TTL_HOURS=168
WAITLIST_ADMIN_EMAILS=

# ─── Google Translate API (optional) ──────────────────────
# Leave empty to use mock translations
GOOGLE_TRANSLATE_API_KEY=

# ─── Translation Provider (REQUIRED for translations) ────
# Supported provider names: opencode, openai, deepseek, ollama, translator-engine
TRANSLATION_PROVIDER_NAME=opencode
# API URL (leave empty for provider default):
#   opencode:          https://api.opencode.com/v1
#   openai:            https://api.openai.com/v1
#   deepseek:          https://api.deepseek.com/v1
#   ollama:            http://ollama:11434
#   translator-engine: http://translator-engine:5000
TRANSLATION_PROVIDER_API_URL=
# API key (required for: opencode, openai, deepseek)
TRANSLATION_PROVIDER_API_KEY=
# Model name (leave empty for provider default):
#   opencode:          gpt-4o-mini
#   openai:            gpt-4o-mini
#   deepseek:          deepseek-chat
#   ollama:            qwen2.5:3b
#   translator-engine: (fixed)
TRANSLATION_PROVIDER_MODEL=

# ─── Unified Provider Chain (recommended, overrides legacy above) ─────────────
# Chain order (first successful provider wins). Cloud providers that are missing
# an API key, rate-limited (429), quota-exhausted, or returning 5xx are skipped
# automatically; the local providers (libretranslate, ollama) always run last.
TRANSLATION_PROVIDER_ORDER=libretranslate,openrouter,nvidia,opencode_go,ollama_local
GRAMMAR_ANALYSIS_PROVIDER_ORDER=openrouter,nvidia,opencode_go,ollama_local
TRANSLATION_CHAIN_TIMEOUT=120

# OpenRouter (primary LLM for analysis + translation fallback)
PROVIDER_OPENROUTER_TYPE=openrouter
PROVIDER_OPENROUTER_API_URL=https://openrouter.ai/api/v1
PROVIDER_OPENROUTER_API_KEY=
PROVIDER_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# NVIDIA AI Foundation (fallback)
PROVIDER_NVIDIA_TYPE=nvidia
PROVIDER_NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
PROVIDER_NVIDIA_API_KEY=
PROVIDER_NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# OpenCode Go (OpenAI-compatible)
PROVIDER_OPENCODE_GO_TYPE=opencode
PROVIDER_OPENCODE_GO_API_URL=https://opencode.ai/zen/go/v1
PROVIDER_OPENCODE_GO_API_KEY=
PROVIDER_OPENCODE_GO_MODEL=deepseek-v4-flash

# LibreTranslate — fast local translation (CPU-only, top-10 languages), first
# translation provider. No API key needed.
PROVIDER_LIBRETRANSLATE_TYPE=libretranslate
PROVIDER_LIBRETRANSLATE_API_URL=http://libretranslate:5000
PROVIDER_LIBRETRANSLATE_TIMEOUT=10

# Local Ollama (final fallback, no rate limits)
PROVIDER_OLLAMA_LOCAL_TYPE=ollama
PROVIDER_OLLAMA_LOCAL_API_URL=http://ollama:11434
PROVIDER_OLLAMA_LOCAL_MODEL=qwen2.5:3b
PROVIDER_OLLAMA_LOCAL_TIMEOUT=600
