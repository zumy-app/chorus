# Mailu environmental configuration — copy to mailu.env and fill in.
# This file is READ by docker-compose.mail.yml (env_file: mailu.env).
# It only ever lives on the dedicated MAIL host — never in the repo, never on
# the Chorus app host, never committed to git (NFR-22 isolation).

# ─── Mailu distribution / version ────────────────────────────────────────────
MAILU_VERSION=2.0

# ─── Domain & hosts ─────────────────────────────────────────────────────────
# The public domain Mailu serves. The mailbox that sends Chorus email must live
# here (e.g. no-reply@your-domain.com).
DOMAIN=your-domain.com
HOSTNAMES=mail.your-domain.com,your-domain.com,admin.your-domain.com
POSTMASTER=postmaster

# ─── TLS ────────────────────────────────────────────────────────────────────
# "letsencrypt" needs the ACME directory + a resolvable hostname.
# "cert" serves a certificate mounted at mail_data/overrides/cert.pem+key.pem.
TLS_FLAVOR=letsencrypt
# ACME account contact email (required by Let's Encrypt).
ACME_EMAIL=postmaster@your-domain.com
# Redirect web root so the bare domain points at the webmail interface.
WEBROOT_REDIRECT=https://webmail.your-domain.com

# ─── Security: secret / admin ───────────────────────────────────────────────
# 64+ char random secret. Use: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openSSL_rand_hex_32
# Initial admin account created on first boot. Change the password immediately.
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=your-domain.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ─── Submission / relay ports (NFR-22) ──────────────────────────────────────
# 587 is the port the Chorus backend uses (MAILU_SMTP_PORT=587, STARTTLS).
# 465 is the implicit-TLS alternative. 25 is outbound delivery to other MX.
SUBMISSION_PORT=587
SMTPS_PORT=465

# ─── Modes ──────────────────────────────────────────────────────────────────
# Auth (login) is required for submission — the Chorus mailbox authenticates
# with MAILU_SMTP_USERNAME / MAILU_SMTP_PASSWORD.
AUTH_RATELIMIT=10/minute
AUTH_LOGIN_WITH_EMAIL=yes
# Outbound relay only: allow sending, do not accept mail for arbitrary domains.
# For a private/relay-only Chorus mailbox this is fine; leave the defaults for a
# full mailbox that also RECEIVES mail.
RECIPIENT_DELIMITER=+
# Mail that cannot be delivered (soft bounce) is retried; keep failures local.
# Consider 'bounce' to preserve NDR handling. Use 'none' if this host is the
# only place that sends and you want quiet retries.
BOUNCE=bounce

# Send encrypted passwords by default (authentication for submission).
# Leave to defaults unless you intentionally disable password login.
